// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  TEAM_LEADER
  TEAM_MEMBER
}

model User {
  id         Int    @id @default(autoincrement())
  password   String
  name       String
  email      String @unique
  phone      String @unique
  role       Role
  settlement String
  area       String
  statusUpdates StatusUpdate[]
}

model Household {
  id             Int     @id @default(autoincrement())
  address        Int     @unique
  contacts       Json
  totalResidents Int
  area           String
  specialNeeds   String?
  statusUpdates StatusUpdate[]

}

enum Status {
  no_answer
  not_home
  at_home
}

model StatusUpdate {
  id            Int      @id @default(autoincrement())
  status        Status
  currentAtHome Int
  lastUpdated   DateTime
  householdId Int
  household Household @relation(fields: [householdId], references: [id])
  userId Int
  user User @relation(fields: [userId], references: [id])
}
